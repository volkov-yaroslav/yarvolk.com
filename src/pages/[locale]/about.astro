---
import { isSecondaryLocale, secondaryLocales } from "@lib/i18n";
import AboutPage from "@src/views/AboutPage.astro";

export function getStaticPaths() {
  return secondaryLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isSecondaryLocale(locale)) {
  return new Response(null, { status: 404, headers: { "content-type": "text/html" } });
}
---

<AboutPage locale={locale} />
