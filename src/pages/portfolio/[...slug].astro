---
import { getEntryBaseSlug, getLocalizedCollection } from "@lib/content";
import PortfolioPostPage from "@src/views/PortfolioPostPage.astro";

export async function getStaticPaths() {
  const items = await getLocalizedCollection("portfolio", "en");
  return items.map((item) => ({
    params: { slug: getEntryBaseSlug(item) },
  }));
}

const { slug } = Astro.params;
---

<PortfolioPostPage locale="en" slug={slug!} />
