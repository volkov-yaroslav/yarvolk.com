---
import { getEntryBaseSlug, getLocalizedCollection } from "@lib/content";
import BlogPostPage from "@src/views/BlogPostPage.astro";

export async function getStaticPaths() {
  const posts = await getLocalizedCollection("blog", "en");
  return posts.map((post) => ({
    params: { slug: getEntryBaseSlug(post) },
  }));
}

const { slug } = Astro.params;
---

<BlogPostPage locale="en" slug={slug!} />
