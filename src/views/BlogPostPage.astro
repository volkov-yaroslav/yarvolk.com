---
import { getAdjacentEntries, getEntryBaseSlug, getLocalizedCollection, getLocalizedEntry } from "@lib/content";
import { getCategoryLabel, localeText, localizeBlogPath, type SiteLocale } from "@lib/i18n";
import { formatDate } from "@utils/formatDate";

import SharePost from "@components/SharePost.astro";
import Layout from "@layouts/Layout.astro";

const { locale = "en", slug } = Astro.props as { locale?: SiteLocale; slug: string };
const text = localeText[locale];

const post = await getLocalizedEntry("blog", slug, locale);
if (!post) {
  return new Response(null, { status: 404, headers: { "content-type": "text/html" } });
}

const posts = await getLocalizedCollection("blog", locale);
const { previous, next } = getAdjacentEntries(posts, slug);

const { title, description, category, image, date, keywords } = post.data as any;
const coverImage = image || "/images/placeholder.webp";
const formattedDate = formatDate(date, "short", text.meta.intlLocale);
const postUrl = Astro.url.href;
const categoryLabel = getCategoryLabel(category, locale);

const { Content } = await post.render();
---

<Layout locale={locale} title={title} description={description} image={coverImage} keywords={keywords}>
  <section class="pt-16 md:pt-24 pb-20 md:pb-28">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-8 text-center banner mb-16" data-aos="fade-up-sm">
          <div class="flex flex-wrap items-center justify-center mb-12 space-x-8">
            <span class="inline-block text-sm rounded-full bg-[#efefef] px-3 py-1 capitalize text-black">
              {categoryLabel}
            </span>
            <span class="opacity-75 text-sm">{formattedDate}</span>
          </div>

          <h1 class="text-4xl md:text-5xl font-secondary font-semibold mb-4 !leading-tight text-balance">{title}</h1>
          <p class="max-w-xl mx-auto text-balance">{description}</p>
        </div>

        <div class="lg:col-10 mx-auto" data-aos="fade-up-sm" data-aos-delay="100">
          <div>
            <img class="block w-full h-auto rounded-lg" src={coverImage} alt={title} width="1020" height="460" />
          </div>
        </div>

        <div class="xl:col-9 lg:col-10 mx-auto" data-aos="fade-in">
          <div class="w-full lg:flex lg:flex-nowrap pt-20">
            <div class="lg:order-2 lg:pl-12 xl:pl-24">
              <article class="content content-light">
                <Content />
              </article>
            </div>

            <div class="hidden lg:block lg:order-1 w-auto">
              <div class="sticky top-8">
                <SharePost title={title} pageUrl={postUrl} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-white text-dark rounded-b-2xl overflow-hidden">
    <div class="container">
      <div class="mb-20">
        <h2 class="text-4xl md:text-5xl font-secondary font-medium -mt-[6px] text-center">
          {text.blog.keepReading}
        </h2>
      </div>
      <div class="row gy-4 sm:gy-4 justify-center">
        {previous && (
          <div class="xl:col-6 lg:col-8 md:col-10">
            <div class="relative group flex items-center z-10">
              <div class="shrink-0 relative overflow-hidden rounded sm:rounded-lg h-[4.5rem] w-[4.5rem] sm:h-28 sm:w-28 self-start pointer-events-none">
                <img
                  src={previous.data.image || "/images/placeholder.webp"}
                  alt={previous.data.title}
                  width={300}
                  height={300}
                  class="duration-500 group-hover:scale-110 group-hover:-rotate-1 object-cover w-full h-full rounded sm:rounded-lg group-hover:brightness-75 bg-light/20"
                />
              </div>
              <div class="grow pl-4 sm:pl-7 transition-all duration-500 group-hover:opacity-60">
                <span class="absolute right-0 sm:-right-1/4 top-0 leading-[0.65] text-[16vh] md:text-[22vh] -z-10 opacity-[0.015] select-none">{text.common.prevShort}</span>
                <div class="flex flex-wrap items-center mb-4 space-x-5">
                  <span class="inline-block text-sm rounded-full bg-[#efefef] px-3 py-1 capitalize">
                    {getCategoryLabel(previous.data.category, locale)}
                  </span>
                  <span class="opacity-75 text-sm">
                    {formatDate(previous.data.date, "short", text.meta.intlLocale)}
                  </span>
                </div>
                <h3 class="text-lg sm:text-2xl leading-snug">
                  <a href={localizeBlogPath(locale, getEntryBaseSlug(previous))} class="stretched-link">
                    {previous.data.title}
                  </a>
                </h3>
              </div>
            </div>
          </div>
        )}
        <div class="lg:col-12" aria-hidden="true"></div>
        {next && (
          <div class="xl:col-6 lg:col-8 md:col-10">
            <div class="relative group flex items-center z-10">
              <div class="grow pr-4 sm:pr-7 transition-all duration-500 group-hover:opacity-60">
                <span class="absolute left-0 sm:-left-1/4 top-0 leading-[0.65] text-[16vh] md:text-[22vh] -z-10 opacity-[0.015] select-none">{text.common.nextShort}</span>
                <div class="flex flex-wrap items-center justify-end mb-4 space-x-5">
                  <span class="opacity-75 text-sm">
                    {formatDate(next.data.date, "short", text.meta.intlLocale)}
                  </span>
                  <span class="inline-block text-sm rounded-full bg-[#efefef] px-3 py-1 capitalize">
                    {getCategoryLabel(next.data.category, locale)}
                  </span>
                </div>
                <h3 class="text-lg sm:text-2xl leading-snug text-right">
                  <a href={localizeBlogPath(locale, getEntryBaseSlug(next))} class="stretched-link">
                    {next.data.title}
                  </a>
                </h3>
              </div>
              <div class="shrink-0 relative overflow-hidden rounded sm:rounded-lg h-[4.5rem] w-[4.5rem] sm:h-28 sm:w-28 self-start pointer-events-none">
                <img
                  src={next.data.image || "/images/placeholder.webp"}
                  alt={next.data.title}
                  width={300}
                  height={300}
                  class="duration-500 group-hover:scale-110 group-hover:-rotate-1 object-cover w-full h-full rounded sm:rounded-lg group-hover:brightness-75 bg-light/20"
                />
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
