---
import { getLocalizedEntry } from "@lib/content";
import { localeText, type SiteLocale } from "@lib/i18n";
import { markdownify } from "@utils/textConverter";

import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";

const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const text = localeText[locale];
const contactPage = await getLocalizedEntry("pages", "contact", locale);

if (!contactPage) {
  return new Response(null, { status: 404, headers: { "content-type": "text/html" } });
}

const { title, subtitle, contactForm, faq }: any = contactPage.data;
const { formEndpoint, mailSubject, successMessage, errorMessage } = contactForm;
const whatsappNumber = "380932404066";
---

<Layout locale={locale} title={title} description={subtitle}>
  <PageHeader title={title} subtitle={subtitle} locale={locale} />

  <section class="py-20 md:py-28 bg-white text-dark rounded-b-2xl">
    <div class="container">
      <div class="row justify-center">
        {contactForm && (
          <div class="md:col-10 lg:col-5 mb-24 lg:mb-0" data-aos="fade-up-sm">
            <h2 class="text-3xl font-medium mb-10 -mt-[6px]">{contactForm.title}</h2>
            <form
              id="contact-form"
              class="pr-0 lg:pr-8"
              method="POST"
              data-form-endpoint={formEndpoint}
              data-whatsapp-number={whatsappNumber}
            >
              <input class="hidden" type="hidden" name="_subject" value={mailSubject} />
              <div class="mb-6">
                <label for="full_name" class="block mb-2 text-black">{text.contact.nameLabel}</label>
                <input
                  type="text"
                  id="full_name"
                  name="full_name"
                  placeholder={text.contact.namePlaceholder}
                  class="border border-light/90 rounded-lg bg-white h-12 w-full px-4 py-4 focus:border-dark/50 outline-none focus-visible:outline-none focus-visible:shadow-none focus-visible:!bg-transparent transition-all duration-300 focus:bg-red-300"
                  required
                />
              </div>
              <div class="mb-6">
                <label for="email" class="block mb-2 text-black">{text.contact.emailLabel}</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder={text.contact.emailPlaceholder}
                  class="border border-light/90 rounded-lg bg-white h-12 w-full px-4 py-4 focus:border-dark/50 outline-none focus-visible:outline-none focus-visible:shadow-none focus-visible:!bg-transparent transition-all duration-300"
                  required
                />
              </div>
              <div class="mb-6">
                <label for="message" class="block mb-2 text-black">{text.contact.messageLabel}</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="border border-light/90 rounded-lg bg-white w-full px-4 py-4 focus:border-dark/50 outline-none focus-visible:outline-none focus-visible:shadow-none focus-visible:!bg-transparent transition-all duration-300"
                  placeholder={text.contact.messagePlaceholder}
                ></textarea>
              </div>

              <div
                id="form-success"
                class="mb-6 mt-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-800 font-medium"
                role="status"
                aria-live="polite"
                style="display:none"
                set:html={markdownify(successMessage, true)}
              ></div>
              <div
                id="form-error"
                class="mb-6 mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-700 font-medium"
                role="alert"
                style="display:none"
                set:html={markdownify(errorMessage, true)}
              ></div>

              <div class="mt-2 flex flex-wrap items-center gap-3">
                <button
                  id="send-button"
                  class="button button-dark cursor-pointer h-[47px]"
                  title={text.contact.sendMessage}
                  type="submit"
                  aria-label={text.contact.sendMessage}
                >
                  <span class="inline-flex items-center h-full">{text.contact.sendMessage}</span>
                </button>

                <a
                  id="whatsapp-button"
                  href={`https://wa.me/${whatsappNumber}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="button button-whatsapp h-[47px]"
                  aria-label={text.contact.chatOnWhatsApp}
                >
                  <span class="inline-flex items-center h-full gap-2 leading-none">
                    <img src="/images/whatsapp.svg" alt="" width="18" height="18" class="block" aria-hidden="true" />
                    {text.contact.chatOnWhatsApp}
                  </span>
                </a>
              </div>
            </form>
          </div>
        )}
        {faq && faq.qaLists.length > 0 && (
          <div class="md:col-10 lg:col-5" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="lg:ml-8 bg-light/15 pt-10 px-6 md:px-8 lg:px-10 pb-4 rounded-lg">
              <div class="mb-6">
                <h2 class="text-3xl font-secondary font-medium -mt-[6px]">{faq.title}</h2>
              </div>

              {faq.qaLists.map((item: any) => (
                <div class="accordion group border-b border-black/10 last:border-b-0">
                  <h3>
                    <button
                      type="button"
                      class="w-full text-left py-5 pr-12 relative"
                      aria-expanded="false"
                    >
                      <span class="block text-lg font-medium">{item.question}</span>
                      <span class="absolute right-0 top-5 text-2xl leading-none">
                        <svg class="opacity-100 group-[.accordion-active]:opacity-0 transition-all absolute top-0" xmlns="http://www.w3.org/2000/svg" height="0.8em" viewBox="0 0 448 512"><path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32V224H48c-17.7 0-32 14.3-32 32s14.3 32 32 32H192V432c0 17.7 14.3 32 32 32s32-14.3 32-32V288H400c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z" fill="currentColor" /></svg>
                        <svg class="opacity-0 group-[.accordion-active]:opacity-100 transition-all absolute top-0" xmlns="http://www.w3.org/2000/svg" height="0.8em" viewBox="0 0 448 512"><path d="M432 256c0 17.7-14.3 32-32 32L48 288c-17.7 0-32-14.3-32-32s14.3-32 32-32l352 0c17.7 0 32 14.3 32 32z" fill="currentColor" /></svg>
                      </span>
                    </button>
                  </h3>
                  <div
                    class="text-black/75 leading-normal overflow-hidden accordion-content max-h-0 will-change-[max-height] opacity-0 group-[.accordion-active]:opacity-100"
                    style={{ transition: "max-height 0.25s ease-out" }}
                  >
                    <div class="-mt-[6px] mb-5 content content-dark" set:html={markdownify(item.answer)}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <script
    type="module"
    is:inline
    define:vars={{
      fallbackError: text.contact.fallbackError,
      sendMessageLabel: text.contact.sendMessage,
      sendingLabel: text.contact.sending,
      whatsappIntro: text.contact.whatsappIntro,
      whatsappNamePrefix: text.contact.whatsappNamePrefix,
      whatsappEmailPrefix: text.contact.whatsappEmailPrefix,
    }}
  >
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.querySelector("#contact-form");
      const successEl = document.querySelector("#form-success");
      const errorEl = document.querySelector("#form-error");
      const sendBtn = document.querySelector("#send-button");
      const whatsappBtn = document.querySelector("#whatsapp-button");
      const messageField = document.querySelector("#message");
      const nameField = document.querySelector("#full_name");
      const emailField = document.querySelector("#email");

      if (!form || !successEl || !errorEl || !sendBtn || !whatsappBtn || !messageField || !nameField || !emailField) {
        return;
      }

      const formEndpoint = form.getAttribute("data-form-endpoint");
      const whatsappNumber = form.getAttribute("data-whatsapp-number");

      const updateWhatsAppLink = () => {
        const name = nameField.value.trim();
        const contactEmail = emailField.value.trim();
        const additionalInfo = messageField.value.trim();

        const parts = [whatsappIntro];
        if (name) parts.push(`${whatsappNamePrefix} ${name}.`);
        if (contactEmail) parts.push(`${whatsappEmailPrefix} ${contactEmail}.`);
        if (additionalInfo) parts.push(additionalInfo);

        whatsappBtn.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(parts.join(" "))}`;
      };

      if (whatsappNumber) {
        updateWhatsAppLink();
        nameField.addEventListener("input", updateWhatsAppLink);
        emailField.addEventListener("input", updateWhatsAppLink);
        messageField.addEventListener("input", updateWhatsAppLink);
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        sendBtn.disabled = true;
        sendBtn.innerHTML = `<span>${sendingLabel}</span>`;

        const formData = {
          name: form.elements.full_name.value,
          email: form.elements.email.value,
          _replyto: form.elements.email.value,
          _subject: form.elements._subject.value,
          message: form.elements.message.value,
        };

        try {
          const response = await fetch(formEndpoint, {
            method: "POST",
            mode: "cors",
            referrerPolicy: "origin-when-cross-origin",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(formData),
          });

          const rawText = await response.text();
          let result = null;

          try {
            result = JSON.parse(rawText);
          } catch {
            result = { success: false };
          }

          if (response.ok && !result?.errors) {
            form.reset();
            updateWhatsAppLink();
            successEl.style.display = "block";
            errorEl.style.display = "none";
            successEl.scrollIntoView({ behavior: "smooth", block: "center" });
          } else {
            throw new Error("Form submission failed");
          }
        } catch {
          successEl.style.display = "none";
          errorEl.textContent = fallbackError;
          errorEl.style.display = "block";
        } finally {
          sendBtn.disabled = false;
          sendBtn.innerHTML = `<span>${sendMessageLabel}</span>`;
        }
      });

      const accordions = document.querySelectorAll(".accordion");
      const openAccordion = (accordion) => {
        const content = accordion.querySelector(".accordion-content");
        accordion.classList.add("accordion-active");
        content.style.maxHeight = `${content.scrollHeight}px`;
      };
      const closeAccordion = (accordion) => {
        const content = accordion.querySelector(".accordion-content");
        accordion.classList.remove("accordion-active");
        content.style.maxHeight = null;
      };

      accordions.forEach((accordion) => {
        const button = accordion.querySelector("button");

        button?.addEventListener("click", () => {
          const isActive = accordion.classList.contains("accordion-active");
          accordions.forEach((item) => closeAccordion(item));
          if (!isActive) openAccordion(accordion);
        });
      });
    });
  </script>
</Layout>
