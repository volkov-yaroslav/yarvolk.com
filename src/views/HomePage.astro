---
import { getEntryBaseSlug, getLocalizedCollection, getLocalizedEntry } from "@lib/content";
import { localizePagePath, localeText, type SiteLocale } from "@lib/i18n";

import Layout from "@layouts/Layout.astro";

import Banner from "@components/Banner";
import BlogCard from "@components/BlogCard.astro";
import PortfolioCard from "@components/PortfolioCard.astro";
import WorkProcess from "@components/WorkProcess.astro";

const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const text = localeText[locale];

const homepage = await getLocalizedEntry("pages", "-index", locale);
if (!homepage) {
  return new Response(null, { status: 404, headers: { "content-type": "text/html" } });
}

const { banner, featuredBy, workProcess }: any = homepage.data;
const portfolioPage = await getLocalizedEntry("pages", "portfolio", locale);
const allPortfolioItems = await getLocalizedCollection("portfolio", locale);
const portfolioItems = allPortfolioItems
  .filter((item) => item.data.category?.toLowerCase() === "website")
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 5);

const blogPage = await getLocalizedEntry("pages", "blog", locale);
const allBlogs = await getLocalizedCollection("blog", locale);
const blogs = allBlogs
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);

const featuredBrandLinks = [
  "https://www.webmastersdesktop.com/",
  "https://www.trimnest.com/",
];
---

<Layout locale={locale} enableLocaleRedirect={locale === "en"}>
  <Banner banner={banner} client:load />

  {featuredBy.enable && (
    <section class="pt-28 lg:pb-10 overflow-hidden">
      <div class="container">
        <div class="row">
          <div class="col-12 mb-10">
            <h2 class="text-3xl font-secondary font-medium text-center" data-aos="fade">
              {featuredBy.title}
            </h2>
          </div>
          <div class="col-12">
            <div class="flex justify-center items-center flex-wrap">
              {featuredBy.brands_white.map((item: string, index: number) => (
                <div
                  class={`mx-2 sm:mx-3 my-2 min-h-9 sm:min-h-16 flex items-center ${index === 0 ? "sm:mx-4" : ""}`}
                  data-aos="fade-left"
                  data-aos-delay={index * 50}
                >
                  {featuredBrandLinks[index] ? (
                    <a
                      href={featuredBrandLinks[index]}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open featured brand ${index + 1}`}
                    >
                      <img
                        src={item}
                        alt="Brand"
                        width={120}
                        height={80}
                        class={`w-auto h-auto block ${index === 0 ? "max-h-9 sm:max-h-16" : "max-h-5 sm:max-h-10"}`}
                      />
                    </a>
                  ) : (
                    <img
                      src={item}
                      alt="Brand"
                      width={120}
                      height={80}
                      class={`w-auto h-auto block ${index === 0 ? "max-h-9 sm:max-h-16" : "max-h-5 sm:max-h-10"}`}
                    />
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="py-20 md:py-28">
    <div class="container">
      <div class="row mb-16 items-end">
        <div class="sm:col-8 order-2 sm:order-1">
          <h2 class="text-4xl md:text-5xl font-secondary font-medium -mt-[6px] text-center sm:text-left">
            {portfolioPage?.data.title}
          </h2>
        </div>
        <div class="sm:col-4 order-1 sm:order-2 block mb-4 sm:mb-0 text-center sm:text-right">
          <span class="font-secondary text-2xl leading-none text-white/75">
            {portfolioPage?.data.subtitle}
          </span>
        </div>
      </div>

      <div class="row md:gx-4 gy-4">
        {portfolioItems.map((portfolioItem, i) => (
          <div
            class={`${i % 5 >= 3 ? "sm:col-6" : "lg:col-4 sm:col-6"} ${i === 4 ? "hidden lg:block" : ""} init-delay`}
            data-aos="fade-up-sm"
            data-aos-duration="500"
            style={{
              "--lg-delay": `${(i % 3) * 75}ms`,
              "--md-delay": `${(i % 2) * 75}ms`,
              "--sm-delay": `${(i % 2) * 75}ms`,
            }}
          >
            <PortfolioCard
              index={i}
              slug={getEntryBaseSlug(portfolioItem)}
              data={portfolioItem.data}
              twoColumns={i % 5 >= 3}
              locale={locale}
            />
          </div>
        ))}
      </div>

      <div class="text-center mt-16">
        <a class="button" href={localizePagePath(locale, "portfolio")}>
          <span>{text.home.allWorks}</span>
        </a>
      </div>
    </div>
  </section>

  <WorkProcess workProcess={workProcess} />

  <section class="py-20 md:py-28 bg-white text-dark rounded-b-2xl">
    <div class="container">
      <div class="row mb-16 items-end">
        <div class="sm:col-8 order-2 sm:order-1">
          <h2 class="text-black text-4xl md:text-5xl font-secondary font-medium -mt-[6px] text-center sm:text-left">
            {blogPage?.data.title}
          </h2>
        </div>
        <div class="sm:col-4 order-1 sm:order-2 block mb-4 sm:mb-0 text-center sm:text-right">
          <span class="font-secondary text-2xl leading-none text-black/75">
            {blogPage?.data.subtitle}
          </span>
        </div>
      </div>

      <div class="row md:gx-4 gy-5">
        {blogs.map((item, index) => (
          <div
            class="md:col-6 lg:col-4 init-delay"
            data-aos="fade-up-sm"
            data-aos-duration="500"
            style={{
              "--lg-delay": `${(index % 3) * 75}ms`,
              "--md-delay": `${(index % 2) * 75}ms`,
              "--sm-delay": `${(index % 2) * 75}ms`,
            }}
          >
            <BlogCard slug={getEntryBaseSlug(item)} data={item.data} locale={locale} />
          </div>
        ))}
      </div>

      <div class="text-center mt-16">
        <a class="button button-dark" href={localizePagePath(locale, "blog")}>
          <span>{text.home.allPosts}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
