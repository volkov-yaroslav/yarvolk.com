---
import "@styles/styles.css";

import siteConfig from "@config/site.config.json";
import Footer from "@layouts/Footer.astro";
import Header from "@layouts/Header";
import {
  defaultLocale,
  getAlternatePaths,
  getLocaleFromPathname,
  localeText,
  localizePagePath,
  stripLocaleFromPathname,
  type SiteLocale,
} from "@lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  locale?: SiteLocale;
  enableLocaleRedirect?: boolean;
  alternates?: Array<{ locale: SiteLocale; href: string }>;
}

const currentLocale = Astro.props.locale ?? getLocaleFromPathname(Astro.url.pathname);
const text = localeText[currentLocale];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const strippedPath = stripLocaleFromPathname(Astro.url.pathname);
const alternateLinks = Astro.props.alternates ?? getAlternatePaths(Astro.url.pathname);
const xDefaultHref = new URL(localizePagePath(defaultLocale, strippedPath === "/" ? "" : strippedPath.slice(1)), Astro.site);

const {
  title = text.meta.siteTitle ?? siteConfig.metaData.title,
  description = text.meta.siteDescription ?? siteConfig.metaData.description,
  image = siteConfig.metaData.ogImage,
  keywords = siteConfig.metaData.keywords,
  enableLocaleRedirect = currentLocale === defaultLocale,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={text.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/png" href={siteConfig.favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="keywords" content={keywords} />
    <link rel="alternate" type="application/rss+xml" title={title} href={new URL("rss.xml", Astro.site)} />
    <meta name="generator" content={Astro.generator} />

    <link rel="stylesheet" href="/plugins/aos/aos.css" />

    <link rel="canonical" href={canonicalURL} />
    {alternateLinks.map((item) => (
      <link
        rel="alternate"
        hreflang={localeText[item.locale].meta.htmlLang}
        href={new URL(item.href, Astro.site)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content={text.meta.intlLocale.replace("-", "_")} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <script
      is:inline
      define:vars={{
        currentLocale,
        defaultLocale,
        enableLocaleRedirect,
        pathname: Astro.url.pathname,
      }}
    >
      const preferredLocaleKey = "yarvolk-preferred-locale";
      const browserToSiteLocale = (value) => {
        if (!value) return null;
        const normalized = value.toLowerCase();
        if (normalized.startsWith("pl")) return "pl";
        if (normalized.startsWith("uk") || normalized.startsWith("ua")) return "ua";
        if (normalized.startsWith("en")) return "en";
        return null;
      };

      const hasLocalePrefix = (value) => value === "/ua" || value === "/pl" || value.startsWith("/ua/") || value.startsWith("/pl/");
      const normalizeTargetPath = (value) => {
        if (!value || value === "/") return "/";
        const normalized = value.replace(/\/+$/, "");
        return normalized || "/";
      };

      const buildLocalizedPath = (locale, value) => {
        const normalizedPath = normalizeTargetPath(value);
        if (locale === defaultLocale) return normalizedPath;
        if (normalizedPath === "/") return `/${locale}`;
        return `/${locale}${normalizedPath}`;
      };

      try {
        if (pathname.startsWith("/ua") || pathname.startsWith("/pl")) {
          localStorage.setItem(preferredLocaleKey, currentLocale);
        }

        if (enableLocaleRedirect && !hasLocalePrefix(pathname)) {
          const storedLocale = localStorage.getItem(preferredLocaleKey);
          const preferredLocale =
            storedLocale ||
            navigator.languages?.map(browserToSiteLocale).find(Boolean) ||
            browserToSiteLocale(navigator.language);

          if (preferredLocale && preferredLocale !== defaultLocale) {
            const nextPath = buildLocalizedPath(preferredLocale, pathname);
            window.location.replace(`${nextPath}${window.location.search}${window.location.hash}`);
          }
        }
      } catch {
        // Ignore storage access errors and keep the English fallback.
      }

      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target.closest("[data-locale-switch]") : null;
        if (!target) return;

        const nextLocale = target.getAttribute("data-locale");
        if (!nextLocale) return;

        try {
          localStorage.setItem(preferredLocaleKey, nextLocale);
        } catch {
          // Ignore storage access errors and continue navigating.
        }
      });
    </script>
  </head>

  <body class="font-primary bg-dark relative z-10 pt--[92px] lg:pt--[106px] min-h-[82vh]">
    <Header client:load locale={currentLocale} />
    <main class="bg-dark relative z-0 pt-[92px] lg:pt-[106px] min-h-[82vh]">
      <slot />
    </main>
    <Footer
      isContactPage={stripLocaleFromPathname(Astro.url.pathname) === "/contact"}
      locale={currentLocale}
      pathname={Astro.url.pathname}
    />

    <script src="/plugins/aos/aos.js" is:inline data-astro-rerun></script>
    <script src="/plugins/aos/aosinit.js" is:inline data-astro-rerun></script>
  </body>
</html>
